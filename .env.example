# ---------------------------------------------------------------------------
# Wastina trust-protocol backend
#
# Copy to .env and fill in real values for your environment.
# Only non-secret defaults and endpoint names belong in this file. Real
# credentials come from your secret store or your shell, never from a committed file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
WASTINA_SERVER_PORT=8080

# --- Database (PostgreSQL) ------------------------------------------------
WASTINA_DATABASE_URL=jdbc:postgresql://localhost:5432/wastina_db
WASTINA_DATABASE_USERNAME=wastina
WASTINA_DATABASE_PASSWORD=replace-with-a-local-only-password

# --- CORS -----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Local development additionally allows WASTINA_FRONTEND_ORIGIN.
# Production: set this to your deployed frontend origin only.
WASTINA_CORS_ALLOWED_ORIGINS=http://localhost:5173
WASTINA_FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
#
# Two mutually exclusive modes. Select one; do not enable both.
# ---------------------------------------------------------------------------

# --- Mode A: Keycloak / OIDC (production, docker) -------------------------
# Leave WASTINA_DEV_JWT_ENABLED=false (or unset) to use this.
WASTINA_OIDC_ISSUER=http://localhost:8081/realms/wastina
WASTINA_OIDC_AUDIENCE=wastina-api

# --- Mode B: local signed JWT (local and development profiles only) -------
# Set WASTINA_DEV_JWT_ENABLED=true together with a 'local' or 'development'
# profile. Startup FAILS if this is enabled under staging, prod, production or
# docker, so a development signing key can never reach a deployed environment.
WASTINA_DEV_JWT_ENABLED=true

# Development signing key, used with HS256. Must be at least 32 characters.
# This value is for local development only. Do not reuse it anywhere else, and
# do not put a production secret here.
WASTINA_DEV_JWT_SECRET=replace-with-a-development-only-signing-key-at-least-32-chars

# Issuer and audience written into development tokens and required on incoming
# ones. Keep them distinct from the OIDC values above.
WASTINA_DEV_JWT_ISSUER=http://localhost/wastina-dev-issuer
WASTINA_DEV_JWT_AUDIENCE=wastina-api

# Access token lifetime in seconds (default 3600).
WASTINA_DEV_JWT_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# Neo4j powers the trust graph. Required by the local profile.
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=replace-with-a-local-only-password

# ---------------------------------------------------------------------------
# Frontend (for reference; these live in the frontend project)
# ---------------------------------------------------------------------------
# The backend listens on WASTINA_SERVER_PORT, so the frontend API base URL is:
#   VITE_API_BASE_URL=http://localhost:<WASTINA_SERVER_PORT>