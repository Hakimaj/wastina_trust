# Copy to .env.local and adjust. Only non-secret defaults belong here.

# --- API ------------------------------------------------------------------
# Must match the backend's WASTINA_SERVER_PORT (default 8080).
VITE_API_BASE_URL=http://localhost:8080
VITE_ENVIRONMENT=local
VITE_DEFAULT_LOCALE=en
VITE_APP_NAME=Wastina

# --- Authentication --------------------------------------------------------
# Which provider issues the session.
#
#   dev-jwt : local development. The app exchanges a persona at
#             POST {VITE_API_BASE_URL}/api/v1/dev/auth/token for a signed bearer
#             token and holds it in memory only (never localStorage). Only works
#             when the backend runs a development profile. Rejected in a
#             production build.
#   oidc    : Keycloak Authorization Code + PKCE. This is the production path and
#             requires the VITE_OIDC_* variables below.
VITE_AUTH_MODE=dev-jwt

# Personas offered by the local development login screen. The backend serves the
# authoritative list from GET /api/v1/dev/auth/personas; this is only a fallback
# used before that request resolves.
VITE_DEV_PERSONAS=worker,employer,guarantor,admin

# --- Keycloak / OIDC (required when VITE_AUTH_MODE=oidc) ------------------
VITE_OIDC_ISSUER=http://localhost:8081/realms/wastina
VITE_OIDC_CLIENT_ID=wastina-api
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/