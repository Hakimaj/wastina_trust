{
  "realm": "wastina",
  "enabled": true,
  "clients": [
    {
      "clientId": "wastina-api",
      "name": "Wastina API",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "wastina-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wastina-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test-user",
      "enabled": true,
      "email": "test@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ]
    }
  ]
}